filters:
  and:
    - file.ext == "md"
    - cssclasses.contains("dictionary-entry")
formulas:
  mechanismen: tags.filter(!value.startsWith("unwort")).join(" · ")
  mechanismen_anzahl: tags.filter(!value.startsWith("unwort")).length
  unwort_jahr: if(tags.filter(value.startsWith("unwort")).length > 0, tags.filter(value.startsWith("unwort")).join("").replace("unwort", ""), "–")
  zeitspanne: if(erstbeleg && letzter_beleg, erstbeleg.toFixed(0) + "–" + letzter_beleg.toFixed(0), if(erstbeleg, erstbeleg.toFixed(0) + "–heute", "–"))
  spektrum_icon: if(spektrum == "affirmativ-dominant", "🔺 affirmativ", if(spektrum == "kritisch-dominant", "🔻 kritisch", if(spektrum == "umkämpft", "⚔️ umkämpft", "– unkodiert")))
  beleglage: if(fußnoten_geprüft, "✅ verifiziert", "⏳ ungeprüft")
  status_label: if(status, status, "publiziert")
properties:
  file.name:
    displayName: Begriff
  title:
    displayName: Titel
  formula.mechanismen:
    displayName: Mechanismen
  formula.mechanismen_anzahl:
    displayName: "# Verfahren"
  formula.unwort_jahr:
    displayName: Unwort d. Jahres
  formula.zeitspanne:
    displayName: Beleg-Zeitspanne
  formula.spektrum_icon:
    displayName: Diskurs-Spektrum
  formula.beleglage:
    displayName: Beleglage
  formula.status_label:
    displayName: Status
  bt_erwähnungen:
    displayName: BT-Erwähnungen
views:
  - type: table
    name: Alle Einträge
    order:
      - file.name
      - title
      - formula.mechanismen
      - formula.mechanismen_anzahl
      - formula.unwort_jahr
    summaries:
      formula.mechanismen_anzahl: Average
  - type: table
    name: Nach Mechanismus
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - title
      - formula.unwort_jahr
  - type: table
    name: Unwort des Jahres
    filters:
      and:
        - tags.filter(value.startsWith("unwort")).length > 0
    order:
      - file.name
      - formula.unwort_jahr
      - formula.mechanismen
  - type: table
    name: 🔮 Wortgefecht-Bilanz (Vision)
    order:
      - file.name
      - formula.spektrum_icon
      - formula.zeitspanne
      - bt_erwähnungen
    summaries:
      bt_erwähnungen: Sum
  - type: table
    name: 🔮 Beleglage (Vision)
    order:
      - file.name
      - formula.beleglage
      - formula.status_label
